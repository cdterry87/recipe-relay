# Production: APP_ENV=production, APP_DEBUG=false, an https APP_URL (this also marks the
# session cookie Secure), LOG_LEVEL=warning, real Turnstile keys, and TRUSTED_PROXIES if
# the app sits behind a load balancer or CDN such as Cloudflare.
APP_NAME="Recipe Relay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8003
APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=recipe_relay
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Proxy IPs or CIDR ranges to trust for the client IP, comma-separated, or * (see config/relay.php).
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit locally. In production, use a transactional provider such as Resend.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Host ports for Sail, chosen to avoid clashes with other local projects
VITE_PORT=5176
FORWARD_DB_PORT=3309
FORWARD_MAILPIT_PORT=1027
FORWARD_MAILPIT_DASHBOARD_PORT=8027

# Google sign-in (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile test keys (always pass). Replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Demo mode for the portfolio site. demo:reset creates the demo account from these values.
DEMO_MODE=true
DEMO_NAME="Demo User"
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=password
DEMO_TIMEZONE="America/Chicago"
